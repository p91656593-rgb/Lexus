-- LEXUS ELITE V13 | FINAL (FOV RAINBOW + TRACERS + APAGADO)
local P = game:GetService("Players")
local RS = game:GetService("RunService")
local Cam = workspace.CurrentCamera
local LP = P.LocalPlayer

local MaxDist = 80   
local MinFOV = 120   

-- Variable de control para apagar o encender el script por completo
_G.LexusActive = true

-- Círculo de FOV fijo con efecto RGB (Rainbow) en la pantalla
local FOVGui = Instance.new("ScreenGui", game.CoreGui)
FOVGui.Name = "LexusFOVDisplay"
local FOFCircle = Instance.new("Frame", FOVGui)
FOFCircle.Size = UDim2.new(0, MinFOV * 2, 0, MinFOV * 2)
FOFCircle.AnchorPoint = Vector2.new(0.5, 0.5)
FOFCircle.Position = UDim2.new(0.5, 0, 0.5, 0)
FOFCircle.BackgroundTransparency = 1
local UIC = Instance.new("UICorner", FOFCircle)
UIC.CornerRadius = UDim.new(1, 0)
local UIS = Instance.new("UIStroke", FOFCircle)
UIS.Thickness = 2

-- Bucle Rainbow para el FOV
task.spawn(function()
    while FOFCircle and FOFCircle.Parent and _G.LexusActive do
        for i = 0, 1, 0.005 do
            if not _G.LexusActive then break end
            UIS.Color = Color3.fromHSV(i, 1, 1)
            task.wait(0.03)
        end
    end
end)

-- Botón flotante chiquito en la pantalla para APAGAR o ENCENDER al instante
local ToggleGui = Instance.new("ScreenGui", game.CoreGui)
ToggleGui.Name = "LexusToggleBtn"
local OffBtn = Instance.new("TextButton", ToggleGui)
OffBtn.Size = UDim2.new(0, 45, 0, 45)
OffBtn.Position = UDim2.new(0.02, 0, 0.25, 0)
OffBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
OffBtn.Text = "OFF"
OffBtn.TextColor3 = Color3.fromRGB(255, 105, 180)
OffBtn.Font = Enum.Font.GothamBold
OffBtn.TextSize = 12
OffBtn.Draggable = true
Instance.new("UICorner", OffBtn).CornerRadius = UDim.new(1, 0)
local OffStroke = Instance.new("UIStroke", OffBtn)
OffStroke.Color = Color3.fromRGB(255, 105, 180)
OffStroke.Thickness = 1.5

-- Función del botón de Apagado total
OffBtn.MouseButton1Click:Connect(function()
    _G.LexusActive = not _G.LexusActive
    if _G.LexusActive then
        OffBtn.Text = "OFF"
        OffBtn.TextColor3 = Color3.fromRGB(255, 105, 180)
        FOVGui.Enabled = true
    else
        OffBtn.Text = "ON"
        OffBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
        FOVGui.Enabled = false
        -- Limpiar elementos visuales al apagar
        for _, p in pairs(P:GetPlayers()) do
            if p.Character then
                if p.Character:FindFirstChild("LexusTracerActive") then p.Character.LexusTracerActive:Destroy() end
            end
        end
    end
end)

