local SecAnonimato = TabVisuales:NewSection("Identidad")

SecAnonimato:NewToggle("Ocultación de Nombre", "Te disfraza usando el nombre de otro jugador", function(state)
    LexusConfig.OcultarNombre = state
    if state then
        task.spawn(function()
            while LexusConfig.OcultarNombre do
                pcall(function()
                    local listaPlayers = Players:GetPlayers()
                    if #listaPlayers > 1 then
                        for _, p in pairs(listaPlayers) do
                            if p ~= LocalPlayer and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                                LocalPlayer.Character.Humanoid.DisplayName = p.DisplayName
                                break
                            end
                        end
                    end
                end)
                task.wait(2)
            end
        end)
    else
        pcall(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                LocalPlayer.Character.Humanoid.DisplayName = LocalPlayer.Name
            end
        end)
    end
end)

local SecESP = TabVisuales:NewSection("Localizadores visuales (ESP)")

SecESP:NewToggle("Etiquetas de Nombres", "Muestra a los rivales a través de paredes", function(state)
    LexusConfig.ESPNombres = state
    if state then
        task.spawn(function()
            while LexusConfig.ESPNombres do
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        if not p.Character.HumanoidRootPart:FindFirstChild("LexusESP") then
                            local bg = Instance.new("BillboardGui", p.Character.HumanoidRootPart)
                            bg.Name = "LexusESP"
                            bg.Size = UDim2.new(0, 100, 0, 30)
                            bg.AlwaysOnTop = true
                            local tl = Instance.new("TextLabel", bg)
                            tl.Size = UDim2.new(1, 0, 1, 0)
                            tl.BackgroundTransparency = 1
                            tl.TextColor3 = Color3.fromRGB(255, 0, 0)
                            tl.Text = p.Name
                        end
                    end
                end
                task.wait(1)
            end
        end)
    else
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character.HumanoidRootPart:FindFirstChild("LexusESP") then
                p.Character.HumanoidRootPart.LexusESP:Destroy()
            end
        end
    end
end)

