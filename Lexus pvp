-- 4. SECCIÓN: AUTOMATIZACIÓN EN LA MANSIÓN
---------------------------------------------------------------------------------
local SecMansion = TabMansion:NewSection("Recolección y Entorno de Mansión")

SecMansion:NewToggle("Recogida de Objetos en la Mansión", "Auto-loot de ítems de la propiedad", function(state)
    LexusConfig.RecogerObjetos = state
    if state then
        task.spawn(function()
            while LexusConfig.RecogerObjetos do
                pcall(function()
                    -- Busca ítems tirados en el workspace o carpetas de la mansión
                    for _, obj in pairs(Workspace:GetChildren()) do
                        if obj:IsA("Tool") or obj:FindFirstChild("TouchTransmitter") then
                            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                local distance = (obj:GetPivot().Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                                if distance <= LexusConfig.RangoMansion then
                                    -- Teletransporta el objeto momentáneamente para agarrarlo
                                    obj:PivotTo(LocalPlayer.Character.HumanoidRootPart.CFrame)
                                end
                            end
                        end
                    end
                end)
                task.wait(0.5)
            end
        end)
    end
end)

